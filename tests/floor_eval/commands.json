{
  "schema_version": 1,
  "trials_per_model": 5,
  "models": {
    "sonnet": {
      "model_id": "claude-sonnet-5",
      "argv": [
        "claude",
        "-p",
        "--model",
        "{model_id}",
        "--safe-mode",
        "--tools",
        "",
        "--output-format",
        "text",
        "{prompt}"
      ],
      "answer_source": "stdout",
      "timeout": 120
    },
    "terra": {
      "model_id": "gpt-5.6-terra",
      "argv": [
        "codex",
        "exec",
        "-s",
        "read-only",
        "-m",
        "{model_id}",
        "--skip-git-repo-check",
        "-o",
        "{outfile}",
        "{prompt}"
      ],
      "answer_source": "outfile",
      "timeout": 180
    },
    "judge": {
      "model_id": "claude-opus-5",
      "argv": [
        "claude",
        "-p",
        "--model",
        "{model_id}",
        "--safe-mode",
        "--tools",
        "",
        "--output-format",
        "text",
        "{prompt}"
      ],
      "answer_source": "stdout",
      "timeout": 120
    }
  }
}
